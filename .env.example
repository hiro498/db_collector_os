# Copy this file to .env and adjust for your environment.
# .env is git-ignored; never commit real secrets.

# Root directory for runtime data (sqlite db, logs, checkpoints, backups)
DB_COLLECTOR_HOME=./var

# Path to the SQLite database file (relative to DB_COLLECTOR_HOME unless absolute)
DB_COLLECTOR_DB_PATH=db_collector.sqlite3

# Path to the YAML config file
DB_COLLECTOR_CONFIG=./config/default.yaml

# Admin UI bind address/port. Keep bound to localhost in production; use an
# SSH tunnel or a reverse proxy with authentication to expose it externally.
DB_COLLECTOR_ADMIN_HOST=127.0.0.1
DB_COLLECTOR_ADMIN_PORT=8787

# Optional: HTTP User-Agent sent by the fetch engine
DB_COLLECTOR_USER_AGENT="DBCollectorOS/0.1 (+https://github.com/hiro498/db_collector_os)"

# Optional: search provider API keys (leave blank to disable search-based discovery)
DB_COLLECTOR_SEARCH_PROVIDER=
DB_COLLECTOR_SEARCH_API_KEY=

# Optional: log level (DEBUG, INFO, WARNING, ERROR)
DB_COLLECTOR_LOG_LEVEL=INFO
